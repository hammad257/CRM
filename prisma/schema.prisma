generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// USER (CRM CORE)
// =========================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")

  firstName String @map("first_name")
  lastName  String @map("last_name")
  avatarUrl String? @map("avatar_url")

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at")

  // security
  tokenVersion Int @default(0) @map("token_version")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  scope          UserScope?
  ownedLeads     Lead[] @relation("LeadOwner")
  createdLeads   Lead[] @relation("LeadCreatedBy")
  linkedCustomerProfile Customer? @relation("UserCustomerLink")
  customerHistoryAuthored CustomerHistory[] @relation("CustomerHistoryAuthor")
  ownedDeals     Deal[] @relation("DealOwner")
  createdDeals   Deal[] @relation("DealCreatedBy")

  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// =========================
// USER SCOPE (ACCESS CONSTRAINTS)
// =========================

model UserScope {
  userId        String   @id @map("user_id")
  campusIds     String[] @default([]) @map("campus_ids")
  departmentIds String[] @default([]) @map("department_ids")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_scopes")
}

// =========================
// REFRESH TOKEN (AUTH)
// =========================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")

  issuedAt  DateTime @default(now()) @map("issued_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// =========================
// ROLE (RBAC)
// =========================

model Role {
  id          String  @id @default(uuid())
  code        String  @unique // SUPER_ADMIN, ADMIN, MANAGER
  name        String
  description String?

  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// =========================
// PERMISSION (RBAC)
// =========================

model Permission {
  id          String @id @default(uuid())
  code        String @unique // user.create, user.delete
  module      String // users, leads, deals
  resource    String // user, lead, deal
  action      String // create, read, update, delete

  description String?

  roles RolePermission[]

  @@index([module, resource])
  @@map("permissions")
}

// =========================
// USER - ROLE LINK
// =========================

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =========================
// ROLE - PERMISSION LINK
// =========================

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  grantedAt DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================
// CUSTOMERS (CRM — profiles, website inquiries)
// =========================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerHistoryType {
  PROFILE_CREATED
  WEB_INQUIRY
  LEAD_SUBMITTED
  PROFILE_UPDATED
  CONTACT_UPDATED
  COMPANY_UPDATED
  NOTE_ADDED
  MANUAL
  LEAD_AUTO_ASSIGNED
  LEAD_CONVERTED_TO_CUSTOMER
  DEAL_WON
}

model Customer {
  id String @id @default(uuid())

  status CustomerStatus @default(ACTIVE)

  firstName String @map("first_name")
  lastName  String @map("last_name")
  displayName String? @map("display_name")

  primaryEmail String @unique @map("primary_email")
  phone        String?
  secondaryEmail String? @map("secondary_email")
  addressLine  String? @map("address_line")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  companyName  String? @map("company_name")
  industry     String?
  website      String?
  companySize  String? @map("company_size")

  jobTitle     String? @map("job_title")

  profileNotes String? @map("profile_notes") @db.Text

  linkedUserId String? @unique @map("linked_user_id")
  linkedUser   User?   @relation("UserCustomerLink", fields: [linkedUserId], references: [id], onDelete: SetNull)

  leads   Lead[]
  deals   Deal[]
  history CustomerHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyName])
  @@index([lastName, firstName])
  @@map("customers")
}

model CustomerHistory {
  id String @id @default(uuid())

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type    CustomerHistoryType @map("type")
  summary String              @db.VarChar(512)
  detail  String?             @db.Text

  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CustomerHistoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_history")
}

// =========================
// INBOUND LEAD ASSIGNMENT (round-robin)
// =========================

model InboundAssignmentState {
  id String @id @default("global")

  cursor Int @default(0) @map("cursor")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inbound_assignment_state")
}

// =========================
// LEADS (CRM)
// =========================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CONVERTED
  LOST
  UNQUALIFIED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  EMAIL_CAMPAIGN
  COLD_OUTREACH
  EVENT
  PARTNER
  OTHER
}

model Lead {
  id String @id @default(uuid())

  title       String?
  companyName String? @map("company_name")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  email       String?
  phone       String?
  jobTitle    String? @map("job_title")

  status LeadStatus @default(NEW)
  source LeadSource @default(OTHER)

  estimatedValue Decimal? @map("estimated_value") @db.Decimal(14, 2)

  description String? @db.Text

  nextFollowUpAt DateTime? @map("next_follow_up_at")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  ownerId String? @map("owner_id")
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerHistoryEntries CustomerHistory[]
  deal Deal?

  @@index([email])
  @@index([companyName])
  @@index([status])
  @@index([source])
  @@index([ownerId])
  @@index([createdAt])
  @@index([customerId])
  @@map("leads")
}

// =========================
// SALES — PIPELINES & DEALS
// =========================

enum DealStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

model Pipeline {
  id String @id @default(uuid())

  name        String
  description String?
  isDefault   Boolean @default(false) @map("is_default")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stages PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id String @id @default(uuid())

  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name            String
  sortOrder       Int    @default(0) @map("sort_order")
  /// 0–100; used for weighted revenue forecast on OPEN deals in this stage
  winProbability  Int    @default(10) @map("win_probability")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals Deal[]

  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id String @id @default(uuid())

  title String
  /// Opportunity value (major currency units)
  amount   Decimal? @db.Decimal(14, 2)
  currency String   @default("USD") @db.VarChar(3)

  status DealStatus @default(OPEN)

  stageId String        @map("stage_id")
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  ownerId String? @map("owner_id")
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  leadId String? @unique @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")

  description String? @db.Text

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([ownerId])
  @@index([customerId])
  @@index([status])
  @@index([expectedCloseDate])
  @@map("deals")
}