DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm?schema=public"

JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_REFRESH_SECRET="optional-separate-secret-for-future-use"
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_DAYS="7"

PORT=3000

# Comma-separated role codes eligible for website lead round-robin (default: SALES_REP)
# INBOUND_LEAD_ASSIGN_ROLE_CODES=SALES_REP

# Base URL for REST: http://localhost:3000/api
# OpenAPI UI: http://localhost:3000/docs
